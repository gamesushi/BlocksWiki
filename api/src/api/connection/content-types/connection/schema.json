{
  "kind": "collectionType",
  "collectionName": "connections",
  "info": {
    "singularName": "connection",
    "pluralName": "connections",
    "displayName": "Connection",
    "description": "图的边：block↔channel（contentChannel 用于频道套频道），以及 block→block 的反链。一条边二选一承载目标——channel 或 targetBlock。唯一事实来源。"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "block": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::block.block",
      "inversedBy": "connections"
    },
    "targetBlock": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::block.block",
      "inversedBy": "incomingLinks"
    },
    "channel": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::channel.channel",
      "inversedBy": "connections"
    },
    "contentChannel": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::channel.channel",
      "inversedBy": "appearances"
    },
    "connector": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "connectorName": {
      "type": "string"
    },
    "position": {
      "type": "integer",
      "default": 0
    },
    "pairKey": {
      "type": "string",
      "unique": true,
      "required": true,
      "private": true
    }
  }
}
