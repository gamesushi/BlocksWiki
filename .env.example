# ============================================================================
# BlockWiki backend — production environment (TEMPLATE)
# Copy this file to `.env` in the SAME directory and fill the values.
# The deploy script `scripts/setup-oracle-vm.sh` generates real random values
# for every secret below, so you normally don't edit this by hand.
# `.env` is gitignored — NEVER commit real secrets.
# ============================================================================

# --- Strapi secrets (generate with: openssl rand -base64 16) ---
APP_KEYS=replaceWithRandomA,replaceWithRandomB,replaceWithRandomC,replaceWithRandomD
API_TOKEN_SALT=replaceWithRandom
ADMIN_JWT_SECRET=replaceWithRandom
JWT_SECRET=replaceWithRandom
TRANSFER_TOKEN_SALT=replaceWithRandom
ENCRYPTION_KEY=replaceWithRandom

# --- Database (SQLite, file persisted in Docker volume) ---
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# --- CORS: comma-separated list of frontend origins allowed to call the API ---
# Example: https://blockwiki.yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=https://blockwiki.yourdomain.com

# --- Cloudflare R2 (public image host) ---
# Create an R2 bucket + API token (Edit / Object Admin) in the Cloudflare dashboard.
# Enable "Public access" on the bucket (or bind a custom domain) and set R2_PUBLIC_URL
# to that public endpoint, e.g. https://pub-xxxx.r2.dev  (NO trailing slash).
# Leave these blank to keep storing uploads on the server's local disk.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=blockswiki
R2_REGION=auto
R2_PUBLIC_URL=
# Leave R2_FOLDER empty: provider delete() omits the folder prefix,
# so a non-empty folder makes deletes target the wrong key.
R2_FOLDER=
