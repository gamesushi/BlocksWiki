# ============================================================================
# LifeWiki backend — production environment (TEMPLATE)
# Copy this file to `.env` in the SAME directory and fill the values.
# The deploy script `scripts/setup-oracle-vm.sh` generates real random values
# for every secret below, so you normally don't edit this by hand.
# `.env` is gitignored — NEVER commit real secrets.
# ============================================================================

# --- Strapi secrets (generate with: openssl rand -base64 16) ---
APP_KEYS=replaceWithRandomA,replaceWithRandomB,replaceWithRandomC,replaceWithRandomD
API_TOKEN_SALT=replaceWithRandom
ADMIN_JWT_SECRET=replaceWithRandom
JWT_SECRET=replaceWithRandom
TRANSFER_TOKEN_SALT=replaceWithRandom
ENCRYPTION_KEY=replaceWithRandom

# --- Database (SQLite, file persisted in Docker volume) ---
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# --- CORS: comma-separated list of frontend origins allowed to call the API ---
# Example: https://lifewiki.yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=https://lifewiki.yourdomain.com
